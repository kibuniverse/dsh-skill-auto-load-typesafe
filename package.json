{
  "name": "dsh-skill-auto-load-typesafe",
  "version": "0.0.2",
  "description": "Preload DeepSeek Harness skills selected by TypeSafe AI.",
  "author": "kibuniverse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibuniverse/dsh-skill-auto-load-typesafe.git"
  },
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "prepack": "npm run build"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "@deepseek-ai/schemastery": "3.18.2",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.3",
    "@deepseek-ai/dsh-storage": "0.1.5-rc.3",
    "@deepseek-ai/dsh-storage-json": "0.1.5-rc.3"
  }
}
